[Unit]
Description=Unicred.fun CLI Miner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/unicred-cli-miner
EnvironmentFile=-/root/.config/unicred-miner/config.env
ExecStart=/usr/bin/node /unicred-cli-miner/miner.js --submit
Restart=always
RestartSec=5
KillSignal=SIGINT
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
